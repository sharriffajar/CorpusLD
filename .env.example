# ====================================================================
# CorpusLD - Environment Configuration Template
# Copy this file to '.env' and configure your preferences:
# cp .env.example .env
# ====================================================================

# --------------------------------------------------------------------
# 1. OPTIONAL CLOUD PARSERS (Tier 1 & 2 Layout Parsing)
# --------------------------------------------------------------------
# LlamaParse API Key (https://cloud.llamaindex.ai/)
LLAMAPARSE_API_KEY=your_llamaparse_api_key_here

# Unstructured API Key & URL (https://unstructured.io/)
UNSTRUCTURED_API_KEY=your_unstructured_api_key_here
UNSTRUCTURED_SERVER_URL=https://api.unstructured.io/general/v0/general

# --------------------------------------------------------------------
# 2. OPTIONAL CLOUD LLM PROVIDERS (BYOK - Bring Your Own Key)
# --------------------------------------------------------------------
# Google Gemini API Key (https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# --------------------------------------------------------------------
# 3. LOCAL VECTOR DATABASE & EMBEDDING CONFIGURATION
# --------------------------------------------------------------------
# Qdrant local embedded storage path
QDRANT_URL=./qdrant_db
QDRANT_COLLECTION_NAME=corpusld_workspace

# Embedding model (Hugging Face)
EMBEDDING_MODEL_NAME=ibm-granite/granite-embedding-107m-multilingual
EMBEDDING_DIMENSION=384

# --------------------------------------------------------------------
# 4. LOCAL OFFLINE LLM CONFIGURATION (Ollama)
# --------------------------------------------------------------------
# Default Ollama model name (e.g. qwen2.5:3b, qwen2.5:1.5b, llama3.2:3b)
OLLAMA_MODEL_NAME=qwen2.5:3b

# Local storage path for Ollama models & Hugging Face cache (Optional)
OLLAMA_MODELS=./models
HF_HOME=./models/huggingface

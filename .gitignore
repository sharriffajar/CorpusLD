# Python Bytecode & Cache
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
.pytest_cache/
pytest-cache-files-*/
pytest-cache-files-*

# Environment Variables & Secrets
.env
.env.local
.env.*.local

# Database & Local Vector Storage
qdrant_db/
*.qdrant
*.db
*.sqlite3

# Uploaded Files & Temporary Storage
uploads/*
!uploads/.gitkeep

# Local Model Weights & Cache
models/
models/*
.cache/*
!.cache/.gitkeep
huggingface/

# IDE, Agent Indexing & Google Drive Temporary Uploads
.tools/
.kilo/
.tmp.driveupload/
.tmp.*/
*.driveupload
.tmp*

# Compressed Archives
*.zip
*.tar.gz
*.7z
*.rar

# Virtual Environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# IDE & Editor Configs
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Log files
*.log

# Benchmark Caches & Test PDF Files
benchmark_results/.chunk_cache/
benchmark_corpus/*.pdf
!benchmark_corpus/README.md
!benchmark_corpus/.gitkeep

# Private Production Engine (Independent Private Repository)
corpusld_engine/
engine_private/
private/

